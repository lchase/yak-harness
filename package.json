{
  "name": "@lchase/yak-harness",
  "version": "0.0.0",
  "description": "Stateless cron reconciler bridging a GitHub Issues backlog and yak",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "yak-harness": "./dist/cli.js"
  },
  "files": [
    "dist",
    "workflows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lchase/yak-harness.git"
  },
  "bugs": {
    "url": "https://github.com/lchase/yak-harness/issues"
  },
  "homepage": "https://github.com/lchase/yak-harness#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "guard:deps": "node scripts/guard-deps.mjs",
    "check": "npm run typecheck && npm run lint && npm run coverage && npm run build && npm run guard:deps"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "2.1.9",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
